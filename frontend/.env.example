# Firebase web app config (public identifiers, not secrets).
# Get these from Firebase console → Project settings → Your apps after
# registering the web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sdfc-udp-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sdfc-udp-dev

# Leave empty in production (same-origin /api via Firebase Hosting rewrite).
# For local dev the Vite proxy forwards /api to localhost:8123 instead.
VITE_API_BASE_URL=
